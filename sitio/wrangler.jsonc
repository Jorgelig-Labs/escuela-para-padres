{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entre-nosotros-junta-padres",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "escuela-padres.jorgeliglabs.com",
      "zone_name": "jorgeliglabs.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*", "/pdf/*"],
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "entre-nosotros-junta-padres-media" }
  ]
}
